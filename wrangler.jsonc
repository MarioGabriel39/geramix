{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "geramix",
  "main": "src/index.js",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "containers": [
    {
      "class_name": "GeraMixContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],

  "durable_objects": {
    "bindings": [
      {
        "name": "GERAMIX_CONTAINER",
        "class_name": "GeraMixContainer"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GeraMixContainer"
      ]
    }
  ]
}
